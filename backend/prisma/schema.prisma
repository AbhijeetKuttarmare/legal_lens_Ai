generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlanTier {
  FREE
  PRO
  ENTERPRISE
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
}

enum DocumentType {
  RENTAL_AGREEMENT
  EMPLOYMENT_CONTRACT
  NDA
  PROPERTY_AGREEMENT
  LOAN_AGREEMENT
  MSA
  PARTNERSHIP_AGREEMENT
  OTHER
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
}

enum SeatTier {
  STANDARD
  PREMIUM
}

enum TeamSubscriptionStatus {
  CREATED
  ACTIVE
  PAST_DUE
  CANCELLED
}

model User {
  id           String    @id @default(uuid())
  email        String?   @unique
  passwordHash String?
  phone        String?   @unique
  name         String?
  firstName    String?
  lastName     String?
  gender       Gender?
  dob          DateTime?
  plan         PlanTier  @default(FREE)
  isAdmin      Boolean   @default(false)
  // Admin testing override for documents.service upload limit checks.
  // null = no override (use plan limit); -1 = unlimited; N = exact cap.
  trialDocumentLimit Int?
  // Pay-per-document credits purchased outside a subscription; consumed when
  // a FREE-plan user is over their plan limit but still wants to upload.
  documentCredits Int @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  documents    Document[]
  payments     Payment[]
  creditOrders CreditOrder[]
  reviews      Review[]
  auditLogs    AuditLog[]
  ownedOrganization   Organization?        @relation("OrganizationOwner")
  organizationMember  OrganizationMember?
}

model Document {
  id            String         @id @default(uuid())
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  fileName      String
  fileType      String
  fileSize      Int?
  storagePath   String
  status        DocumentStatus @default(UPLOADED)
  documentType  DocumentType?
  extractedText String?
  language      String         @default("en")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  summary        Summary?
  clauseAnalysis ClauseAnalysis?
  riskAnalysis   RiskAnalysis?
  chatMessages   ChatMessage[]
}

model Summary {
  id          String   @id @default(uuid())
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId  String   @unique
  documentType String
  summaryText String   @db.Text
  createdAt   DateTime @default(now())
}

model ClauseAnalysis {
  id         String   @id @default(uuid())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String   @unique
  clauses    Json
  createdAt  DateTime @default(now())
}

model RiskAnalysis {
  id         String    @id @default(uuid())
  document   Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String    @unique
  score      Int
  level      RiskLevel
  flags      Json
  suggestions Json
  createdAt  DateTime  @default(now())
}

model ChatMessage {
  id         String   @id @default(uuid())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String
  role       String
  content    String   @db.Text
  createdAt  DateTime @default(now())
}

model Payment {
  id                String        @id @default(uuid())
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  plan              PlanTier
  amount            Int
  currency          String        @default("INR")
  status            PaymentStatus @default(CREATED)
  razorpayOrderId   String        @unique
  razorpayPaymentId String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model CreditOrder {
  id                String        @id @default(uuid())
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  credits           Int
  amount            Int
  currency          String        @default("INR")
  status            PaymentStatus @default(CREATED)
  razorpayOrderId   String        @unique
  razorpayPaymentId String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  owner     User     @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId   String   @unique
  seatTier  SeatTier @default(STANDARD)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members      OrganizationMember[]
  subscription TeamSubscription?
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String       @unique
  // 'OWNER' | 'MEMBER'
  role           String       @default("MEMBER")
  joinedAt       DateTime     @default(now())
}

model TeamSubscription {
  id                     String                  @id @default(uuid())
  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId         String                  @unique
  razorpaySubscriptionId String                  @unique
  razorpayPlanId         String
  seatTier               SeatTier
  seatCount              Int
  status                 TeamSubscriptionStatus  @default(CREATED)
  currentPeriodEnd       DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
}

model Review {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  rating    Int
  comment   String?  @db.Text
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  // 'ADMIN' = action taken from the admin panel, 'USER' = end-user triggered
  // (upload, review, profile edit...), 'SYSTEM' = backend-triggered (webhook).
  actorType  String   @default("ADMIN")
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId    String?
  actorLabel String
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
}

model ErrorLog {
  id         String   @id @default(uuid())
  message    String   @db.Text
  stack      String?  @db.Text
  path       String?
  method     String?
  statusCode Int?
  createdAt  DateTime @default(now())
}

model OtpLog {
  id        String   @id @default(uuid())
  phone     String
  // 'REQUESTED' | 'VERIFIED' — never stores the actual OTP code.
  action    String
  success   Boolean
  createdAt DateTime @default(now())
}

// Persisted so a pending OTP session survives a backend redeploy or Render's
// free-tier spin-down — it previously lived in an in-memory Map, which wiped
// out on every restart mid-login. Never stores the actual OTP digits, only
// the 2Factor.in session id needed to verify it.
model OtpSession {
  id        String   @id @default(uuid())
  phone     String   @unique
  sessionId String
  expiresAt DateTime
  createdAt DateTime @default(now())
}
